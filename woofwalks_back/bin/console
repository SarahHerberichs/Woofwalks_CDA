#!/usr/bin/env php
<?php

// DEBUG : vérifier si les variables Railway sont visibles
echo "APP_ENV = " . ($_ENV['APP_ENV'] ?? 'non défini') . PHP_EOL;
echo "APP_DEBUG = " . ($_ENV['APP_DEBUG'] ?? 'non défini') . PHP_EOL;
echo "DATABASE_URL = " . ($_ENV['DATABASE_URL'] ?? 'non défini') . PHP_EOL;

// Kernel normal
use App\Kernel;
use Symfony\Bundle\FrameworkBundle\Console\Application;

require_once dirname(__DIR__).'/vendor/autoload_runtime.php';

return function (array $context) {
    $kernel = new Kernel(
        $context['APP_ENV'] ?? $_ENV['APP_ENV'] ?? 'prod',
        (bool) ($context['APP_DEBUG'] ?? $_ENV['APP_DEBUG'] ?? 0)
    );

    return new Application($kernel);
};

